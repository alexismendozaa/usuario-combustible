# ============================================
# Fuel Backend - Variables de Entorno
# Copia este archivo a .env y configura los valores
# ============================================

# ========== BASE DE DATOS ==========
# Para desarrollo local (sin Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fuel_db?schema=public"
# Para Docker Compose (usa el nombre del servicio):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/fuel_db?schema=public"

# ========== JWT ==========
JWT_ACCESS_SECRET="cambia-este-secreto-en-produccion"
ACCESS_TOKEN_TTL=900
JWT_REFRESH_SECRET="cambia-este-secreto-refresh-en-produccion"
REFRESH_TOKEN_TTL=2592000

# ========== URL DE LA APLICACIÓN ==========
# Para desarrollo local:
APP_PUBLIC_URL="http://localhost:3000"
# Para producción:
# APP_PUBLIC_URL="https://tu-dominio.com"

# ========== SMTP (Email) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password"
MAIL_FROM="Fuel App <tu-email@gmail.com>"

# ========== AWS S3 ==========
S3_PUBLIC_BASE_URL="https://tu-bucket.s3.amazonaws.com"
S3_UPLOAD_PREFIX="uploads/avatars"

# ========== STRIPE ==========
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_SUCCESS_URL="myapp://payment/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="myapp://payment/cancel"
STRIPE_CURRENCY="usd"
